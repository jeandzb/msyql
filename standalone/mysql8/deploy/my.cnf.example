[mysqld]
# ============================================================
# MySQL 8.0 通用生产配置模板（Docker 场景）
# 适用场景：
#   1) 单实例单节点：一台宿主机只跑一个 MySQL 实例
#   2) 多实例单节点：一台宿主机跑多个 MySQL Docker 实例
#
# 使用方式：
#   - 公共项直接保留
#   - 带有【单实例单节点】/【多实例单节点】备注的参数，按实际场景调整
#   - 不建议同时保存多份模板，直接维护这一份即可
#
# 重要原则：
#   - 数据完整性优先：开启 binlog，开启严格持久化
#   - 快速恢复优先：为 XtraBackup + PITR 做准备
#   - 多实例场景下，不能按单实例独占宿主机来配置内存和连接数
# ============================================================


# ============================================================
# 一、基础配置（大多数场景通用）
# ============================================================

pid-file                        = /var/lib/mysql/mysqld.pid
user                            = mysql
port                            = 3306
default_time_zone               = '+08:00'

# 字符集配置
character-set-server            = utf8mb4
collation-server                = utf8mb4_general_ci

# 表名大小写策略
# 注意：已有数据的实例不要随意修改该值
lower_case_table_names          = 1

# 跳过 DNS 反解析，减少连接建立延迟
skip-name-resolve

# SQL 模式：建议保留严格模式
sql_mode                        = STRICT_TRANS_TABLES,NO_ZERO_DATE,NO_ZERO_IN_DATE,ERROR_FOR_DIVISION_BY_ZERO

# 认证相关
# 如果业务客户端较老，保留当前兼容方式；
# 如果确认所有客户端都支持 caching_sha2_password，可后续再统一调整
authentication_policy           = mysql_native_password
default_authentication_plugin   = caching_sha2_password


# ============================================================
# 二、实例唯一标识（必须按实例单独修改）
# ============================================================

# 【必须按实例单独修改】
# 即使现在不做主从，也建议每个实例都配置唯一 server-id
# 单实例单节点：可以直接设为 1
# 多实例单节点：同一宿主机上每个实例必须不同，例如 101/102/103
server-id                       = 1

# 【必须按实例单独修改】
# 如果同一台宿主机部署多个实例，端口必须不同
# 例如：3306 / 3307 / 3308 ...
# 单实例单节点：保持 3306 即可
# 多实例单节点：按容器映射关系独立分配
# port                            = 3306


# ============================================================
# 三、连接管理
# ============================================================

# 最大连接数
# 【单实例单节点建议】300 ~ 500
#   - 如果数据库独占宿主机，且业务连接池压力较高，可设 500
# 【多实例单节点建议】150 ~ 300
#   - 多实例时不要每个实例都设很高，否则总内存和线程开销会放大
# 下面给一个偏稳妥的默认值：
max_connections                 = 300

# 线程缓存
# 适度调大，避免线程频繁创建销毁
thread_cache_size               = 64

# 空闲连接回收
wait_timeout                    = 600
interactive_timeout             = 600

# 每连接私有缓冲，不能设太大，否则高并发时容易放大内存占用
sort_buffer_size                = 256K
join_buffer_size                = 256K
read_buffer_size                = 256K
read_rnd_buffer_size            = 512K
thread_stack                    = 256K


# ============================================================
# 四、表缓存 / 文件句柄
# ============================================================

# 表缓存
# 【单实例单节点建议】2000 ~ 4000
# 【多实例单节点建议】1000 ~ 2000
# 如果表不多、负载一般，不要盲目调太高
table_open_cache                = 1500
table_definition_cache          = 1500

# 打开文件上限
# 多实例场景尤其建议保留
# 但宿主机 / Docker 运行时的 nofile 限制也要同步调大，否则此值未必生效
open_files_limit                = 65535


# ============================================================
# 五、InnoDB 内存配置
# ============================================================

# 关闭 AHI，减少额外内存与部分热点争用
innodb_adaptive_hash_index      = OFF

# 若你更关注内存节省，可继续关闭 performance_schema
# 如果后续需要更细致排障，可改为 ON
performance_schema              = OFF

# InnoDB Buffer Pool
#
# 这是最需要按场景调整的参数之一：
#
# 【单实例单节点建议】
#   - 如果这台宿主机基本只跑一个 MySQL 实例：
#   - 可设为“容器可用内存”的 50% ~ 65%
#   - 例如容器 12G，可先设 6G ~ 8G
#
# 【多实例单节点建议】
#   - 每个实例不要按“独占宿主机”去配置
#   - 一般设为“该实例容器内存上限”的 40% ~ 55%
#   - 宿主机总内存要给 OS / page cache / Docker / 备份任务预留 20%~30%
#
# 下面默认给一个适合多实例也能用的稳妥值
innodb_buffer_pool_size         = 4G

# Buffer Pool 实例数
# 小内存实例不必过高
# 经验上：
#   2G~4G  -> 2
#   4G~8G  -> 4
#   8G+    -> 4 或 8
innodb_buffer_pool_instances    = 4


# ============================================================
# 六、InnoDB I/O 配置
# ============================================================

# Docker + Linux + SSD 场景推荐
innodb_flush_method             = O_DIRECT

# SSD 场景下通常关闭 flush_neighbors
innodb_flush_neighbors          = 0

# IO 能力
# 【单实例单节点建议】2000 / 4000
# 【多实例单节点建议】1000 / 2000 起步，避免多个实例同时打满磁盘
innodb_io_capacity              = 1000
innodb_io_capacity_max          = 2000


# ============================================================
# 七、Redo / 持久化（数据完整性重点区域）
# ============================================================

# Redo 日志大小
# 【单实例单节点建议】1G
# 【多实例单节点建议】512M ~ 1G
# 如果写入量较大可保留 1G；如果实例多、磁盘压力大可下调到 512M
innodb_log_file_size            = 1G
innodb_log_files_in_group       = 2
innodb_log_buffer_size          = 64M

# ------------------------------
# 数据完整性优先：建议固定如下
# ------------------------------
# 说明：
#   innodb_flush_log_at_trx_commit = 1
#   sync_binlog = 1
# 这是更偏“强一致/崩溃安全”的配置
# 若你要求“快速恢复 + 尽量保证数据完整性”，建议就保持这样
innodb_flush_log_at_trx_commit  = 1
sync_binlog                     = 1


# ============================================================
# 八、Binlog（PITR 必须开启）
# ============================================================

# 重要：
# 不要再使用 skip-log-bin
# 要做时间点恢复（PITR），必须开启 binlog

# 【建议按实例独立目录规划】
# 单实例单节点：
#   可先放在 datadir 内，如 /var/lib/mysql/mysql-bin
#
# 多实例单节点：
#   强烈建议每个实例单独挂载 binlog 目录，例如：
#   /data/mysql/instance_a/binlog/mysql-bin
#   /data/mysql/instance_b/binlog/mysql-bin
#
# 如果你当前尚未单独挂载 binlog 目录，可先保留如下写法：
log_bin                         = /var/lib/mysql/mysql-bin

# 恢复和审计友好型配置
binlog_format                   = ROW
binlog_row_image                = FULL

# binlog 保留时间：14天
# 可按业务恢复窗口改成 7天 / 14天 / 30天
binlog_expire_logs_seconds      = 1209600

# 单个 binlog 文件大小
max_binlog_size                 = 256M

# GTID
# 即使当前不做主从，也建议开启，便于后续恢复/迁移/演进
gtid_mode                       = ON
enforce_gtid_consistency        = ON


# ============================================================
# 九、日志配置
# ============================================================

# 慢查询日志
slow_query_log                  = 1
long_query_time                 = 2

# 建议日志与 datadir 分离
# 容器中挂载到 /var/log/mysql
slow_query_log_file             = /var/log/mysql/slow.log
log_error                       = /var/log/mysql/error.log


# ============================================================
# 十、其他安全/稳定性建议
# ============================================================

skip-host-cache
skip-symbolic-links


# ============================================================
# 十一、场景切换说明（只看这一段就能快速改）
# ============================================================
#
# 【如果你是：单实例单节点】
# 典型特征：
#   - 一台宿主机只跑一个 MySQL Docker 实例
#   - 数据库基本独占该宿主机资源
#
# 重点调整：
#   1) server-id = 1
#   2) max_connections = 300 ~ 500
#   3) innodb_buffer_pool_size = 容器内存的 50% ~ 65%
#      例如容器 12G，可设 6G 或 8G
#   4) innodb_io_capacity = 2000
#      innodb_io_capacity_max = 4000
#   5) table_open_cache / table_definition_cache = 2000 ~ 4000
#   6) binlog 可先放 datadir 内，但更推荐单独目录
#
#
# 【如果你是：多实例单节点】
# 典型特征：
#   - 同一台数据库宿主机跑多个 MySQL Docker 实例
#   - 每个实例只是共享宿主机资源的一部分
#
# 重点调整：
#   1) 每个实例的 server-id 必须不同
#   2) 每个实例的 port 必须不同
#   3) 每个实例的 datadir / log / binlog / backup 目录必须隔离
#   4) max_connections 不要设太高，建议 150 ~ 300
#   5) innodb_buffer_pool_size 不要按独占宿主机去配
#      一般控制在“该实例容器内存上限”的 40% ~ 55%
#   6) table_open_cache / table_definition_cache 建议 1000 ~ 2000
#   7) innodb_io_capacity 建议从 1000 / 2000 起步
#   8) 每个实例都要有独立的 binlog 路径
#
#
# 【无论哪种场景，都建议保持不变的关键项】
#   - innodb_flush_log_at_trx_commit = 1
#   - sync_binlog = 1
#   - log_bin 开启
#   - binlog_format = ROW
#   - binlog_row_image = FULL
#   - slow_query_log 开启
#   - 日志目录与 datadir 分离
#
# ============================================================