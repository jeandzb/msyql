#!/usr/bin/env bash

# =========================
# 基础路径
# =========================
BASE_DIR="/alphesh/mysql/mysql8_3309"
BACKUP_DIR="${BASE_DIR}/backup"
FULL_DIR="${BACKUP_DIR}/full"
INC_DIR="${BACKUP_DIR}/inc"
BINLOG_ARCHIVE_DIR="${BACKUP_DIR}/binlog"
RESTORE_TEST_DIR="${BACKUP_DIR}/restore_test"
SCRIPT_LOG_DIR="${BASE_DIR}/logs/backup_script"

# =========================
# 容器与连接信息
# =========================
MYSQL_CONTAINER="mysql8_test"
COMPOSE_FILE="./docker-compose.yaml"

MYSQL_HOST="mysql8"
MYSQL_PORT="3306"
MYSQL_USER="backup"
MYSQL_PASSWORD="StrongBackupPass!"

# =========================
# MySQL 数据/日志路径
# 要与你的 compose / my.cnf 对应
# =========================
MYSQL_BINLOG_DIR="${BASE_DIR}/binlog"
MYSQL_DATA_DIR="${BASE_DIR}/data"

# =========================
# 保留策略
# =========================
FULL_RETENTION_DAYS=28
INC_RETENTION_DAYS=14
BINLOG_RETENTION_DAYS=14

# =========================
# 其他
# =========================
DATE="$(date +%F)"
TS="$(date +%F_%H-%M-%S)"
LATEST_FULL_LINK="${FULL_DIR}/latest"
LATEST_PREPARED_LINK="${BACKUP_DIR}/latest_prepared"

mkdir -p "${FULL_DIR}" "${INC_DIR}" "${BINLOG_ARCHIVE_DIR}" "${RESTORE_TEST_DIR}" "${SCRIPT_LOG_DIR}"