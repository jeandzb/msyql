#!/usr/bin/env bash

# XtraBackup 环境配置
#
# 使用方式：
# 1. 当前项目可直接使用本文件默认值。
# 2. 迁移到其他项目时，优先替换下方“模板变量”对应项。
# 3. 生产环境建议通过外部环境变量覆盖密码，不要把真实密码长期写死在仓库中。
#
# 常用模板变量：
#   {{BASE_DIR}}             部署目录，例如 /alphesh/soft/mysql8_dev
#   {{BACKUP_ROOT_DIR}}      备份根目录，例如 /mnt/mysql_nfs_backup/mysql8_dev
#   {{DATA_DIR}}             MySQL 数据根目录，例如 /alphesh/data/mysql8_dev
#   {{MYSQL_CONTAINER}}      生产 MySQL 容器名，例如 mysql8_dev
#   {{MYSQL_HOST}}           XtraBackup 连接地址，例如 mysql8_dev
#   {{MYSQL_PORT}}           MySQL 端口，例如 3306
#   {{MYSQL_USER}}           备份用户，例如 backup
#   {{MYSQL_PASSWORD}}       备份用户密码
#   {{MYSQL_ROOT_USER}}      root 用户名，通常是 root
#   {{MYSQL_ROOT_PASSWORD}}  root 密码
#   {{COMPOSE_FILE}}         compose 文件路径，例如 /alphesh/soft/mysql8_dev/docker-compose.yaml
#   {{BACKUP_MOUNT_DIR}}     xtrabackup 容器内备份挂载根目录，通常是 /backup/xtrabackup
#   {{MYSQL_BINLOG_MOUNT_DIR}} xtrabackup 容器内 binlog 挂载目录，通常是 /var/lib/mysql-bin

# =========================
# 基础路径
# 当前默认值已对齐 192.168.0.253 / mysql8_dev
# =========================
BASE_DIR="${BASE_DIR:-/alphesh/soft/mysql8_dev}"
BACKUP_ROOT_DIR="${BACKUP_ROOT_DIR:-/mnt/mysql_nfs_backup/mysql8_dev}"
BACKUP_DIR="${BACKUP_DIR:-${BACKUP_ROOT_DIR}/xtrabackup}"
FULL_DIR="${BACKUP_DIR}/full"
INC_DIR="${BACKUP_DIR}/inc"
BINLOG_ARCHIVE_DIR="${BACKUP_DIR}/binlog"
RESTORE_TEST_DIR="${BACKUP_DIR}/restore_test"
SCRIPT_LOG_DIR="${BACKUP_DIR}/logs/backup_script"
DATA_DIR="${DATA_DIR:-/alphesh/data/mysql8_dev}"

# xtrabackup 容器内挂载路径
# 必须与 compose 中 xtrabackup 服务的挂载保持一致
BACKUP_MOUNT_DIR="${BACKUP_MOUNT_DIR:-/backup/xtrabackup}"
FULL_MOUNT_DIR="${BACKUP_MOUNT_DIR}/full"
INC_MOUNT_DIR="${BACKUP_MOUNT_DIR}/inc"
BINLOG_ARCHIVE_MOUNT_DIR="${BACKUP_MOUNT_DIR}/binlog"
RESTORE_TEST_MOUNT_DIR="${BACKUP_MOUNT_DIR}/restore_test"

# =========================
# 容器与连接信息
# =========================
MYSQL_CONTAINER="${MYSQL_CONTAINER:-mysql8_dev}"
COMPOSE_FILE="${COMPOSE_FILE:-${BASE_DIR}/docker-compose.yaml}"

# 说明：
# - MYSQL_HOST 是 xtrabackup 容器访问 MySQL 的主机名，通常直接填生产容器服务名
# - MYSQL_USER 建议使用 backup 用户
# - archive_binlog.sh 会使用 MYSQL_ROOT_USER / MYSQL_ROOT_PASSWORD 执行 FLUSH BINARY LOGS
MYSQL_HOST="${MYSQL_HOST:-mysql8_dev}"
MYSQL_PORT="${MYSQL_PORT:-3306}"
MYSQL_USER="${MYSQL_USER:-backup}"
MYSQL_PASSWORD="${MYSQL_PASSWORD:-alphesh123}"
MYSQL_ROOT_USER="${MYSQL_ROOT_USER:-root}"
MYSQL_ROOT_PASSWORD="${MYSQL_ROOT_PASSWORD:-alphesh123}"

# =========================
# MySQL 数据 / binlog 路径
# 必须与 compose / my.cnf 对应
# =========================
MYSQL_BINLOG_DIR="${DATA_DIR}/binlog"
MYSQL_DATA_DIR="${DATA_DIR}/data"
MYSQL_BINLOG_MOUNT_DIR="${MYSQL_BINLOG_MOUNT_DIR:-/var/lib/mysql-bin}"

# =========================
# 保留策略
# 单位：天
# =========================
FULL_RETENTION_DAYS=28
INC_RETENTION_DAYS="${FULL_RETENTION_DAYS}"
BINLOG_RETENTION_DAYS=14

# =========================
# 压缩策略
# =========================
XTRABACKUP_COMPRESS_ENABLED="${XTRABACKUP_COMPRESS_ENABLED:-1}"
XTRABACKUP_COMPRESS_THREADS="${XTRABACKUP_COMPRESS_THREADS:-2}"
XTRABACKUP_DECOMPRESS_THREADS="${XTRABACKUP_DECOMPRESS_THREADS:-2}"
BINLOG_ARCHIVE_COMPRESS_ENABLED="${BINLOG_ARCHIVE_COMPRESS_ENABLED:-1}"
BINLOG_ARCHIVE_COMPRESS_CMD="${BINLOG_ARCHIVE_COMPRESS_CMD:-gzip -f}"

# =========================
# 运行时派生变量
# =========================
DATE="$(date +%F)"
TS="$(date +%F_%H-%M-%S)"
LATEST_FULL_LINK="${FULL_DIR}/latest"
LATEST_PREPARED_LINK="${BACKUP_DIR}/latest_prepared"

# 确保目录存在。
# 这些目录只会创建在备份目录和恢复测试目录，不会碰生产 datadir。
mkdir -p "${FULL_DIR}" "${INC_DIR}" "${BINLOG_ARCHIVE_DIR}" "${RESTORE_TEST_DIR}" "${SCRIPT_LOG_DIR}"

run_xtrabackup() {
  docker compose --profile backup -f "${COMPOSE_FILE}" run --rm xtrabackup xtrabackup "$@"
}

xtrabackup_backup_compress_args() {
  if [[ "${XTRABACKUP_COMPRESS_ENABLED}" == "1" ]]; then
    printf '%s\n' "--compress"
    printf '%s\n' "--compress-threads=${XTRABACKUP_COMPRESS_THREADS}"
  fi
}
